---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			body {
				background: #fff5f7;
				min-height: 100vh;
				font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'WenQuanYi Micro Hei', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
			}
			main {
				max-width: 800px;
				margin: 0 auto;
				padding: 60px 20px;
			}
			.section {
				margin-bottom: 40px;
				animation: fadeIn 0.6s ease-in;
			}
			.section h4 {
				font-size: 1.2rem;
				line-height: 1.8;
				color: #333;
				margin: 0 0 30px 0;
				text-align: center;
				font-weight: 400;
			}
			.section img, .section video {
				width: 100%;
				border-radius: 32px;
				box-shadow: 0 4px 20px rgba(0,0,0,0.1);
				display: block;
				margin: 0 auto;
			}
			.section video {
				max-height: 600px;
			}
			.header {
				text-align: center;
				margin-bottom: 60px;
			}
			.header h4 {
				font-size: 1.5rem;
				font-weight: 500;
				color: #222;
			}
			@keyframes fadeIn {
				from { opacity: 0; transform: translateY(20px); }
				to { opacity: 1; transform: translateY(0); }
			}
			#ring-container {
				width: 100%;
				height: 400px;
				margin: 60px 0;
			}
		</style>
		<script type="importmap">
			{
				"imports": {
					"three": "https://cdn.jsdelivr.net/npm/three@0.161.0/build/three.module.js",
					"three/addons/": "https://cdn.jsdelivr.net/npm/three@0.161.0/examples/jsm/"
				}
			}
		</script>
	</head>
	<body>
		<main>
			<div class="header">
				<h4>2024 九月 我遇到了我生命中最重要的你 Tiffany</h4>
			</div>

			<div class="section">
				<img src="/wtf/tiffany-first.jpg" alt="Tiffany">
			</div>

			<div class="section">
				<h4>我們走過了Napa 那天你在如何忙於工作還是擠出時間陪我晚上看恐怖片👻</h4>
				<video controls>
					<source src="/wtf/napa.mp4" type="video/mp4">
				</video>
			</div>

			<div class="section">
				<h4>Chicago 我們喝的微醺 你問我說 '是我漂亮還是這城市夜景漂亮' 我很害羞回答 '你吧'😊</h4>
				<img src="/wtf/chicago.jpg" alt="Chicago">
			</div>

			<div class="section">
				<h4>Halloween, 我們裝扮Harley and Joker, 在Allen walker演場會 你讓我感到年輕的活力</h4>
				<img src="/wtf/halloween.jpg" alt="Halloween">
			</div>

			<div class="section">
				<h4>Christmas, 你陪我在我家佈置了聖誕樹</h4>
				<img src="/wtf/xmas.jpg" alt="Christmas">
			</div>

			<div class="section">
				<h4>2024年底, 你帶我體驗了人生第一次滑雪, 我們都摔個半死, 但我們都很倔, 爬起來繼續滑, 我希望我們的感情也是如此, 我們無論如何, 都會爬起來 繼續往前</h4>
				<img src="/wtf/snow1.jpg" alt="Snow 1">
			</div>

			<div class="section">
				<img src="/wtf/snow2.jpg" alt="Snow 2">
			</div>

			<div class="section">
				<h4>儘管 這些期間 我還是Founder 你了解我既沒有時間又窮 你還是選擇了我🥺</h4>
				<h4>2025是個神奇的一年 我們都經歷了人生重大的轉變</h4>
        <h4>我們一起去了Vegas 讓你破費請我吃高檔鐵板燒</h4>
				<img src="/wtf/vegas.jpg" alt="Vegas">
			</div>

			<div class="section">
        <h4>因為妳 我有機會去了一趟美麗的Yosemite 儘管我當時工作很忙 你還是體諒我 開車載我 為了讓我多放鬆 幫我減輕壓力</h4>
				<img src="/wtf/yos.jpg" alt="Vegas">
			</div>

			<div class="section">
        <h4>同個月 我們第一次 一起出國旅行 來到西班牙 雖然說碰到大停電 我們還有些小紛爭 但我還是感到很幸福 有你帶我走過世界的角落</h4>
        <img src="/wtf/spain.jpg" alt="Spain">
			</div>

			<div class="section">
        <h4>2025 我們去過好多國家 帶給我好多美好的回憶 我很難想像沒有的日子 我仍然是在井裡的青蛙</h4>
        <img src="/wtf/cabo.jpg" alt="cabo">
        <br>
        <img src="/wtf/hawaii.jpg" alt="hawaii">
			</div>

			<div class="section">
        <h4>我想要說的是</h4>
        <h4>我感到無比幸運 能夠遇到 真正愛我並關心我的你</h4>
        <h4>我也很感激 你願意接受我的不完整</h4>
        <h4>我相信 我們的不同讓彼此更完整 也讓我們在相互學習中不斷成長</h4>
        <h4>我保證 無論遇到什麼樣的困難 我都會 在你身旁 一起解決面對</h4>
        <h4>你是我生命中最重要的一切</h4>
        <h4>我願意用我的一生 愛你 照顧你 支持你</h4>
        <h4>Tiffany 你願意</h4>
        <h4>嫁給我 並且繼續我們的故事嗎?</h4>
        <h4>像是Big Bang 一切才剛開始</h4>
			</div>

			<div id="ring-container"></div>
		</main>

		<script type="module">
			import * as THREE from 'three';
			import { RoundedBoxGeometry } from 'three/addons/geometries/RoundedBoxGeometry.js';

			const container = document.getElementById('ring-container');
			const scene = new THREE.Scene();
			const camera = new THREE.PerspectiveCamera(75, container.clientWidth / container.clientHeight, 0.1, 1000);
			const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });

			renderer.setSize(container.clientWidth, container.clientHeight);
			renderer.setClearColor(0x000000, 0);
			container.appendChild(renderer.domElement);

			// Create rounded box
			const boxGeometry = new RoundedBoxGeometry(2, 1, 1.5, 10, 0.15);
			const boxMaterial = new THREE.MeshStandardMaterial({
				color: 0xe0fffa,
				metalness: 0.1,
				roughness: 0.1,
				emissive: 0xa0e7e0,
				emissiveIntensity: 0.6
			});
			const box = new THREE.Mesh(boxGeometry, boxMaterial);
			box.position.y = -1;
			scene.add(box);

			// Create ring group
			const ringGroup = new THREE.Group();
			ringGroup.position.y = 0.6;
			scene.add(ringGroup);

			// Create ring band
			const ringGeometry = new THREE.TorusGeometry(1, 0.1, 16, 100);
			const ringMaterial = new THREE.MeshStandardMaterial({
				color: 0xffffff,
				metalness: 0.95,
				roughness: 0.02,
				emissive: 0xf5f5f5,
				emissiveIntensity: 0.6
			});
			const ring = new THREE.Mesh(ringGeometry, ringMaterial);
			ringGroup.add(ring);

			// Create diamond on top of ring
			const diamondGeometry = new THREE.OctahedronGeometry(0.3);
			const diamondMaterial = new THREE.MeshPhysicalMaterial({
				color: 0xff69b4,
				metalness: 0.1,
				roughness: 0,
				transmission: 0.7,
				thickness: 0.5,
				clearcoat: 1,
				clearcoatRoughness: 0,
				emissive: 0xd91e78,
				emissiveIntensity: 0.3
			});
			const diamond = new THREE.Mesh(diamondGeometry, diamondMaterial);
			diamond.position.y = 1.4;
			ringGroup.add(diamond);


			// Lighting
			const ambientLight = new THREE.AmbientLight(0xffffff, 1.2);
			scene.add(ambientLight);

			const pointLight1 = new THREE.PointLight(0xffffff, 1);
			pointLight1.position.set(5, 5, 5);
			scene.add(pointLight1);

			const pointLight2 = new THREE.PointLight(0xffb6c1, 0.5);
			pointLight2.position.set(-5, -5, 5);
			scene.add(pointLight2);

			camera.position.z = 3;

			function animate() {
				requestAnimationFrame(animate);
				ringGroup.rotation.y += 0.01;
				renderer.render(scene, camera);
			}
			animate();

			window.addEventListener('resize', () => {
				camera.aspect = container.clientWidth / container.clientHeight;
				camera.updateProjectionMatrix();
				renderer.setSize(container.clientWidth, container.clientHeight);
			});
		</script>
	</body>
</html>
